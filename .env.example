# 复制为 .env 后填入自己的密钥（.env 已被 .gitignore 忽略，不会提交）
# cp .env.example .env

# ---- 必填 ----
CHATBOT_API_KEY=sk-xxxx

# ---- 接口地址与模型 ----
# DeepSeek 官方：https://api.deepseek.com
# OpenAI 官方：https://api.openai.com/v1
CHATBOT_BASE_URL=https://api.deepseek.com
CHATBOT_MODEL=deepseek-chat

# ---- 生成参数（temperature 必须在 0~2 之间）----
CHATBOT_TEMPERATURE=0.7
# 留空表示使用服务端默认值
CHATBOT_MAX_TOKENS=

# ---- 对话行为 ----
CHATBOT_SYSTEM_PROMPT=你是一个乐于助人的中文助手，回答简洁准确。
CHATBOT_MAX_HISTORY_MESSAGES=20

# ---- 网络 ----
CHATBOT_REQUEST_TIMEOUT=60
