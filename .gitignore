# ---- 密钥与本地配置 ----
# 真实密钥只放在 .env，绝不提交；.env.example 是模板，需要进仓库
.env
.env.local
.env.*
!.env.example

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
pytest-cache-files-*/
.venv/
venv/

# ---- 数据库 ----
# SQLite 文件由程序启动时自动创建，绝不提交
*.db
*.db-journal
*.db-wal
*.db-shm

# ---- 编辑器 ----
.vscode/
.idea/
*.swp

# ---- 系统 ----
.DS_Store
Thumbs.db
